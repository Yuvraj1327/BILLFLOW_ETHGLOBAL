# ── BillFlow backend. Copy to .env and fill in. NEVER commit the real .env. ──
APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Set to false in production to hide /docs and /openapi.json
ENABLE_DOCS=true
PUBLIC_CHECKOUT_BASE_URL=http://localhost:8080

# ── Supabase ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. Never ship to Flutter. Used for Storage uploads.
SUPABASE_SERVICE_ROLE_KEY=
# Token verification: set ONE of the two
# legacy HS256 projects (Project Settings > API > JWT secret)
SUPABASE_JWT_SECRET=
# asymmetric keys: <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=invoice-documents
# Direct Postgres connection used by the backend (Supabase > Project Settings > Database > Connection string, pooled).
# The role needs to bypass RLS (postgres / service role) because ALL writes go through this backend.
DATABASE_URL=

# ── Anthropic (server only) ──
ANTHROPIC_API_KEY=
# set explicitly, e.g. a model id from your Anthropic console; there is no default
ANTHROPIC_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_PDF_PAGES=20

# ── Whitechain Sepolia (OP Stack L2) ──
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
WHITECHAIN_CHAIN_ID=1874
WHITECHAIN_EXPLORER_URL=https://explorer.testnet.whitechain.io
# UNVERIFIED candidate from the brief; confirm on the explorer before use
WHITECHAIN_USDT_ADDRESS=
# read decimals() from the token and set it. NOT assumed. Invoices cannot be created without it
USDT_DECIMALS=
# BillFlowPayments address after YOUR deployment (see docs/deployments.md)
WHITECHAIN_PAYMENT_CONTRACT=
# InvoiceFinancing address after YOUR deployment
WHITECHAIN_FINANCING_CONTRACT=
# optional; Step 2 merged the registry into InvoiceFinancing, so leave blank or equal to the line above
WHITECHAIN_INVOICE_REGISTRY=

# EIP-712 quote signer (testnet key, server only). Its ADDRESS must equal BillFlowPayments.quoteSigner().
# It only signs payment quotes; it never holds or moves user funds. Generate a fresh throwaway key; never reuse a funded key.
QUOTE_SIGNER_PRIVATE_KEY=
QUOTE_TTL_SECONDS=900

# ── Indexer ──
# true = run inside the API process; or run `python -m app.workers.blockchain_indexer` separately
INDEXER_ENABLED=false
INDEXER_POLL_SECONDS=5
INDEXER_BATCH_BLOCKS=500
# block of your contract deployment (avoids scanning from genesis)
INDEXER_START_BLOCK=
INDEXER_RESCAN_OVERLAP=12
MIN_CONFIRMATIONS=3

# ── Limits ──
MAX_UPLOAD_BYTES=10485760
PAYMENT_LINK_TTL_DAYS=30
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# ── Step 6: refunds, merchant API, webhooks ──
# BillFlowRefunds address (refunds are disabled until set)
WHITECHAIN_REFUNDS_CONTRACT=
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=6
# dev ONLY: allows http:// and localhost/private webhook targets (ignored when APP_ENV=production)
WEBHOOK_ALLOW_INSECURE_URLS=false
API_KEY_RATE_LIMIT_PER_MINUTE=120

