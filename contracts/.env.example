# ── Contracts (Foundry). NEVER commit the real .env ──
WHITECHAIN_SEPOLIA_RPC_URL=https://rpc.testnet.whitechain.io
CHAIN_ID=1874
EXPLORER_URL=https://explorer.testnet.whitechain.io
EXPLORER_API_URL=                   # TO VERIFY (Blockscout-style API) — needed for `forge verify-contract`

# Official Whitechain testnet USDT. A candidate address was supplied by you but is NOT yet verified:
# run `forge script script/CheckUsdt.s.sol --rpc-url $WHITECHAIN_SEPOLIA_RPC_URL` and compare
# name/symbol/decimals with the official Whitechain/sponsor documentation before deploying.
USDT_ADDRESS=

# Role addresses (public addresses only). Deployer = whoever signs the deploy tx.
ADMIN_ADDRESS=            # DEFAULT_ADMIN_ROLE on both contracts (config, signer rotation, allowlist toggle)
QUOTE_SIGNER_ADDRESS=     # backend EIP-712 quote signer (hot key, testnet only)
PAUSER_ADDRESS=
ISSUER_ADDRESS=           # may register invoices on behalf of approved businesses
VERIFIER_ADDRESS=         # human verification: approve businesses/investors, verify/reject invoices
OPERATOR_ADDRESS=         # backend operator: publish/cancel offers on behalf, mark defaults

# Deploy with a Foundry keystore, not a raw key in this file:
#   cast wallet import deployer --interactive
#   forge script script/Deploy.s.sol --rpc-url $WHITECHAIN_SEPOLIA_RPC_URL --account deployer --broadcast
