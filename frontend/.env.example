# ── Flutter PUBLIC configuration only (bundled as a Flutter asset and loaded by flutter_dotenv at startup). NO secrets here. ──
# Never put the Supabase service-role key, Anthropic key, or any private key in this file or in Flutter.
API_BASE_URL=http://localhost:8006/api/v1
SUPABASE_URL=
SUPABASE_ANON_KEY=                  # anon key only
CHAIN_ID=1874
RPC_URL=https://rpc.testnet.whitechain.io
EXPLORER_URL=https://explorer.testnet.whitechain.io
# where the Flutter Web build is served (used when building payment links in the UI)
CHECKOUT_BASE_URL=http://localhost:8080
# Contract + USDT addresses are NOT configured here on purpose: the app reads them from the backend
# (GET /blockchain/config and the public invoice endpoint), which verifies them with its on-chain preflight.
