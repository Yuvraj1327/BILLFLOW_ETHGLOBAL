# ── BillFlow backend. Copy to .env and fill in. NEVER commit the real .env. ──
APP_ENV=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
PUBLIC_CHECKOUT_BASE_URL=http://localhost:8080

# ── Supabase ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # SERVER ONLY. Never ship to Flutter. Used for Storage uploads.
# Token verification: set ONE of the two
SUPABASE_JWT_SECRET=            # legacy HS256 projects (Project Settings > API > JWT secret)
SUPABASE_JWT_JWKS_URL=          # asymmetric keys: <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=invoice-documents
# Direct Postgres connection used by the backend (Supabase > Project Settings > Database > Connection string, pooled).
# The role needs to bypass RLS (postgres / service role) because ALL writes go through this backend.
DATABASE_URL=

# ── Anthropic (server only) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                # set explicitly, e.g. a model id from your Anthropic console; there is no default
AI_TIMEOUT_SECONDS=60
AI_MAX_PDF_PAGES=20

# ── Whitechain Sepolia (OP Stack L2) ──
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
WHITECHAIN_CHAIN_ID=1874
WHITECHAIN_EXPLORER_URL=https://explorer.testnet.whitechain.io
WHITECHAIN_USDT_ADDRESS=        # UNVERIFIED candidate from the brief; confirm on the explorer before use
USDT_DECIMALS=                  # read decimals() from the token and set it. NOT assumed. Invoices cannot be created without it
WHITECHAIN_PAYMENT_CONTRACT=    # BillFlowPayments address after YOUR deployment (see docs/deployments.md)
WHITECHAIN_FINANCING_CONTRACT=  # InvoiceFinancing address after YOUR deployment
WHITECHAIN_INVOICE_REGISTRY=    # optional; Step 2 merged the registry into InvoiceFinancing, so leave blank or equal to the line above

# EIP-712 quote signer (testnet key, server only). Its ADDRESS must equal BillFlowPayments.quoteSigner().
# It only signs payment quotes; it never holds or moves user funds. Generate a fresh throwaway key; never reuse a funded key.
QUOTE_SIGNER_PRIVATE_KEY=
QUOTE_TTL_SECONDS=900

# ── Indexer ──
INDEXER_ENABLED=false           # true = run inside the API process; or run `python -m app.workers.blockchain_indexer` separately
INDEXER_POLL_SECONDS=5
INDEXER_BATCH_BLOCKS=500
INDEXER_START_BLOCK=            # block of your contract deployment (avoids scanning from genesis)
INDEXER_RESCAN_OVERLAP=12
MIN_CONFIRMATIONS=3

# ── Limits ──
MAX_UPLOAD_BYTES=10485760
PAYMENT_LINK_TTL_DAYS=30
PUBLIC_RATE_LIMIT_PER_MINUTE=60
